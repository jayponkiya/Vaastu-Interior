# Response headers (Netlify and Cloudflare Pages format).
# HTML gets the host default (revalidate on every visit), so new content shows
# straight away. Only static assets get long cache lifetimes here.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# CSS and JS: pages link them as *.min.* with ?v=<content hash> (written by
# scripts/build-assets.js), so a change always gets a new URL. Vendor files
# are pinned versions; give an updated vendor file a new name.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change under the same name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video keep their names when replaced, so cache for 30 days.
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/video/*
  Cache-Control: public, max-age=2592000

# Icons and manifest: one week.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# Pages that must never be indexed (they also carry a robots meta tag).
/thank-you
  X-Robots-Tag: noindex
/404
  X-Robots-Tag: noindex
